{
  "name": "tlc",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma digital do TLC Ponta Porã - MS",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "npm run start:dev -w @tlc/api",
    "dev:web": "npm run dev -w @tlc/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @tlc/api",
    "db:verify": "npm run db:verify -w @tlc/api"
  }
}
