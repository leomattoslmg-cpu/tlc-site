NODE_ENV=development
PORT=3000
# URL pública da API; usada no campo "type" dos erros RFC 9457
API_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://tlc:tlc@localhost:5432/tlc
# Sem REDIS_URL, a Idempotency-Key usa memória (serve só para desenvolvimento)
REDIS_URL=redis://localhost:6379
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3001
