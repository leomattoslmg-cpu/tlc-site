# URL base da API da plataforma, com /v1. Sem ela, as páginas dinâmicas mostram o estado vazio.
NEXT_PUBLIC_API_URL=http://localhost:3000/v1
# URL pública deste site (usada no sitemap e nos metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Para onde vai o botão Entrar (portal do membro)
NEXT_PUBLIC_PORTAL_URL=/portal/entrar
# Domínio do CDN das imagens (opcional)
NEXT_PUBLIC_CDN_HOST=
# Chave pública do captcha (Cloudflare Turnstile). Sem ela, o formulário usa um token de desenvolvimento.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Contatos exibidos no rodapé (preencha com os dados reais do TLC)
NEXT_PUBLIC_CONTATO_EMAIL=
NEXT_PUBLIC_CONTATO_INSTAGRAM=
